{
  "version": 8,
  "name": "OSRS Gielinor",
  "metadata": {
    "travlr:id": "osrs",
    "travlr:category": "Artistic",
    "travlr:description": "Old School RuneScape Gielinor-inspired parchment map.",
    "travlr:font-note": "Labels use DIN Offc Pro Bold styled gold+black to approximate OSRS text. Swap glyphs URL + font stack for a proper runic font once hosted.",
    "_mlSpaceColor": "#0a0a14"
  },
  "sources": {
    "composite": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "__ml-terrain": {
      "type": "raster-dem",
      "tiles": [
        "https://cdn.jsdelivr.net/gh/travlr-earth/style-builder@main/styles/tiles/terrain/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 5,
      "attribution": "Terrain: SRTM (NASA/USGS), public domain"
    }
  },
  "sprite": "https://cdn.jsdelivr.net/gh/travlr-earth/style-builder@main/styles/osrs/sprite/sprite",
  "glyphs": "https://cdn.jsdelivr.net/gh/travlr-earth/style-builder@main/styles/fonts/{fontstack}/{range}.pbf",
