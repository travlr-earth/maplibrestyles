{
  "version": 8,
  "name": "OSRS Gielinor",
  "metadata": {
    "travlr:id": "osrs",
    "travlr:category": "Artistic",
    "travlr:description": "Old School RuneScape Gielinor-inspired parchment map.",
    "travlr:font-note": "Labels use DIN Offc Pro Bold styled gold+black to approximate OSRS text. Swap glyphs URL + font stack for a proper runic font once hosted.",
    "_mlSpaceColor": "#0a0a14"
  },
  "sources": {
    "composite": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "__ml-terrain": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 12,
      "attribution": "Terrain: Mapzen/AWS Open Data (SRTM, NASA/USGS)"
    },
    "__ml-contours": {
      "type": "vector",
      "url": "pmtiles://https://travlr-tiles.matsmiersen.workers.dev/styles/tiles/contours.pmtiles",
      "maxzoom": 8,
      "minzoom": 8,
      "attribution": "Contours: SRTM (NASA/USGS), pre-generated"
    },
    "__ml-bathymetry": {
      "type": "vector",
      "url": "pmtiles://https://travlr-tiles.matsmiersen.workers.dev/styles/tiles/bathymetry.pmtiles",
      "attribution": "Bathymetry: Natural Earth"
    },
    "__ml-ne-landcover": {
      "type": "vector",
      "url": "pmtiles://https://travlr-tiles.matsmiersen.workers.dev/styles/tiles/ne-landcover.pmtiles",
      "minzoom": 0,
      "maxzoom": 6,
      "attribution": "Natural Earth (naturalearthdata.com)"
    }
  },
  "sprite": "https://travlr-tiles.matsmiersen.workers.dev/styles/osrs/sprite/sprite",
  "glyphs": "https://travlr-tiles.matsmiersen.workers.dev/styles/fonts/{fontstack}/{range}.pbf",
